    "version": "0.2.0",
    "configurations": [
        {
            "name": "messenger",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define-from-file",
                "secrets.json"
            ]
        },
        {
            "name": "messenger (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define-from-file",
                "secrets.json"
            ]
        },
        {
            "name": "messenger (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--dart-define-from-file",
                "secrets.json"
            ]
        },
        {
            "name": "Flutter (Chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "--dart-define-from-file",
                "secrets.json"
            ]
        },
        {
            "name": "Flutter (Physical Phone)",
            "request": "launch",
            "type": "dart",
            "deviceId": "L759NFJZCICMFQPZ",
            "args": [
                "--dart-define-from-file",
                "secrets.json"
            ]
        },
    ],
    "compounds": [
        {
            "name": "All Devices (Chrome & Phone)",
            "configurations": [
                "Flutter (Chrome)",
                "Flutter (Physical Phone)"
            ]
        }
    ]
}